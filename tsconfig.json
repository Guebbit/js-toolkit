{
    "compilerOptions": {
        "strict": true,
        "target": "es6",
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "baseUrl": "src",
        "sourceMap": true,
        // dom.iterable is required: getForm, getIndex and appendChildren spread
        // NodeList/HTMLCollection, and FormData is iterated in the tests
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "./dist/types"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
