{
    "compilerOptions": {
        "strict": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "baseUrl": "src",
        "lib": ["dom", "dom.iterable", "es2022"],
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": false,
        "noEmit": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
