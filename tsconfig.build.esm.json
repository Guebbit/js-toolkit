{
    // Declarations are emitted next to each build, not into one shared
    // folder. TypeScript decides whether a .d.ts describes an ESM or a
    // CommonJS module from the nearest package.json `type`, so a single
    // copy can only ever be correct for one of the two formats.

    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "module": "es2022",
        "moduleResolution": "bundler",
        "outDir": "./dist/esm",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true
    },
    "include": ["src"]
}
