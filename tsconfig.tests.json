{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // The test tree is type-checked by `tsc`, not by ts-jest: `isolatedModules`
        // in the base config puts ts-jest in transpile-only mode, so a type error
        // in a test never reaches the jest run. This project is the gate that makes
        // tests/types.test.ts mean anything.
        "noEmit": true,
        "types": ["jest", "node"]
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": []
}
