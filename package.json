{
    "name": "@guebbit/js-toolkit",
    "version": "1.2.3",
    "license": "AGPLv3.0",
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG"
    ],
    "sideEffects": false,
    "scripts": {
        "prepare": "husky",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:target": "jest /tests/getColorBrightness.spec.ts",
        "test:mutation": "stryker run",
        "lint": "eslint \"*/**/*.{ts,js,json}\"",
        "lint:fix": "eslint \"*/**/*.{ts,js,json}\" --fix",
        "prettier": "npx prettier .",
        "prettier:check": "npx prettier --check .",
        "prettier:fix": "npx prettier . --write",
        "docs:dev": "vitepress dev docs --port 8080",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "update:all": "npm-check-updates -u",
        "complete:check": "npm run lint && npm run prettier:check && npm run build && npm run test",
        "complete": "npm run lint:fix && npm run prettier:fix && npm run build && npm run test && npm run docs:build",
        "publish:public": "npm run complete && npm publish --access public"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.0.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@types/eslint": "^8.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@typescript-eslint/parser": "^8.64.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unicorn": "^57.0.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jsdom": "^29.1.1",
        "npm-check-updates": "^22.2.9",
        "prettier": "^3.9.5",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "vitepress": "^1.6.4"
    }
}
