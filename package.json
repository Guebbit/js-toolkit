{
    "name": "@guebbit/js-toolkit",
    "version": "2.3.0",
    "description": "Framework-free TypeScript helpers — arrays, strings, numbers, time, formatting, DOM, browser platform — shipped as a dual ESM/CommonJS build with no runtime dependencies.",
    "keywords": [
        "typescript",
        "toolkit",
        "utilities",
        "helpers",
        "array",
        "string",
        "dom",
        "browser",
        "cookies",
        "query-string",
        "esm",
        "commonjs"
    ],
    "homepage": "https://guebbit.github.io/js-toolkit/",
    "bugs": {
        "url": "https://github.com/Guebbit/js-toolkit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Guebbit/js-toolkit.git"
    },
    "license": "AGPLv3.0",
    "author": "Guebbit",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./internal/*": null,
        "./*": {
            "import": {
                "types": "./dist/esm/*.d.ts",
                "default": "./dist/esm/*.js"
            },
            "require": {
                "types": "./dist/cjs/*.d.ts",
                "default": "./dist/cjs/*.js"
            }
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
        "test": "jest --config jest.config.cjs",
        "test:types": "tsc -p tsconfig.types.json",
        "test:package": "publint --strict && node tests/package/attw.mjs && node tests/package/smoke.mjs && node tests/package/dtsGuard.mjs",
        "test:mutation": "stryker run",
        "test:mutation:incremental": "stryker run --incremental",
        "test:mutation:check": "node scripts/mutation-baseline.mjs",
        "lint": "eslint \"*/**/*.{ts,js,json}\"",
        "lint:fix": "eslint \"*/**/*.{ts,js,json}\" --fix",
        "prettier": "npx prettier . --check",
        "prettier:fix": "npx prettier . --write",
        "docs:dev": "vitepress dev docs --port 8080",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "update:all": "npm-check-updates -u",
        "complete": "npm run lint:fix && npm run prettier:fix && npm run typecheck && npm run build && npm run test:package && npm run test && npm run test:types && npm run docs:build",
        "complete:check": "npm run lint && npm run prettier && npm run typecheck && npm run build && npm run test:package && npm run test && npm run test:types && npm run docs:build",
        "check:clean": "node -e \"const s=require('child_process').execSync('git status --porcelain').toString();if(s.trim()){console.error('working tree is not clean — commit or stash before publishing:\\n'+s);process.exit(1)}\"",
        "prepublishOnly": "npm run check:clean && npm run complete:check",
        "publish:public": "npm publish --access public"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.0.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@types/eslint": "^8.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@typescript-eslint/parser": "^8.64.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unicorn": "^57.0.0",
        "expect-type": "^1.4.0",
        "fast-check": "^4.10.2",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jsdom": "^29.1.1",
        "mermaid": "^11.17.2",
        "npm-check-updates": "^22.2.9",
        "prettier": "^3.9.5",
        "publint": "^0.3.24",
        "ts-jest": "^29.4.11",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17"
    }
}
